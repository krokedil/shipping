{
    "name": "krokedil/shipping",
    "description": "Shipping method extensions from Krokedil",
    "type": "library",
    "version": "2.4.1",
    "require": {
        "php": "~7.4 || ~8.0",
        "psr/container": "2.0.x-dev"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "dev-develop",
        "php-stubs/wordpress-stubs": "*",
        "php-stubs/woocommerce-stubs": "dev-master",
        "phpunit/phpunit": "^9.6",
        "clean/phpdoc-md": "dev-master",
        "10up/wp_mock": "^1.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Krokedil\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Krokedil\\Shipping\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "tests/*",
            "docs/*",
            "phpunit.xml",
            "phpcs.xml",
            ".phpdoc-md",
            "composer-lock.json",
            ".gitignore",
            ".gitattributes",
            "phpstan.neon",
            "phpstan-baseline.neon",
            ".github"
        ]
    },
    "minimum-stability": "dev",
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpunit": "./vendor/bin/phpunit --bootstrap tests/bootstrap.php",
        "createdocs": "./vendor/bin/phpdoc-md",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan:baseline": "./vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline"
    },
    "scripts-descriptions": {
        "phpstan": "Run PHPStan static analysis at the level set in phpstan.neon. Findings that predate the analysis are suppressed by phpstan-baseline.neon, so a failure means new code introduced it.",
        "phpstan:baseline": "Regenerate phpstan-baseline.neon from the current findings. Only run this when intentionally accepting new suppressions, otherwise fix the reported errors instead."
    }
}
